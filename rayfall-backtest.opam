opam-version: "2.0"
synopsis: "Rayfall backtester model, native saved runs and Async IPC reader"
maintainer: ["Vincent Bernardoff"]
authors: ["Vincent Bernardoff"]
license: "ISC"
homepage: "https://github.com/deepmarker/rayfall-backtest"
bug-reports: "https://github.com/deepmarker/rayfall-backtest/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.1"}
  "core" {>= "v0.17" & < "v0.18"}
  "core_unix" {>= "v0.17" & < "v0.18"}
  "async" {>= "v0.17" & < "v0.18"}
  "yojson"
  "digestif"
  "ppx_jane" {>= "v0.17" & < "v0.18"}
  "rayforce-ipc"
  "rayforce-ipc-async"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/deepmarker/rayfall-backtest.git"
x-maintenance-intent: ["(latest)"]
