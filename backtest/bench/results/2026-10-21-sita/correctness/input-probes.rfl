;; Run from backtest. These are observations, not acceptance tests.
(load "bt.rfl")
(load "report.rfl")
(set cfg {cash0: 1000 fee_ppm: 1000 start: 2026.01.01D00:00:00.000 period: 1D steps: 3 max_weight_ppm: 1000000 max_gross_ppm: 1000000 buy_policy: 'SCALE})
(set ins (table [sym mult min_qty min_notional] (list [X] [1] [1] [0])))
(set T0 (at cfg 'start))
(set bars (table [ts sym o c] (list (+ T0 (* (til 3) 1D)) [X X X] [10 10 10] [10 10 10])))
(set tg (table [ts sym target] (list (enlist (+ T0 1D)) [X] [2])))
(set modified (fn [keyname value]
  (dict (key cfg) (map (fn [k] (if (== k keyname) value (at cfg k))) (key cfg)))))
(set probe (fn [label f]
  (let run_result (try (do (f) 'accepted) (fn [e] e)))
  (println (list label run_result))
  (if (== (type run_result) 'sym)
      (println (list "identity check" (try (bt_check_identities) (fn [e] e)))))))
(probe "null bar time" (fn [] (bt_run cfg ins (table [ts sym o c] (list [0Np] [X] [10] [10])) bt_no_targets)))
(probe "null multiplier" (fn [] (bt_run cfg (table [sym mult min_qty min_notional] (list [X] [0Nl] [1] [0])) bars tg)))
(probe "negative fee" (fn [] (bt_run (modified 'fee_ppm -1000000) ins bars tg)))
(probe "null fee" (fn [] (bt_run (modified 'fee_ppm 0Nl) ins bars tg)))
(probe "missing fee" (fn [] (bt_run (dict (except (key cfg) [fee_ppm]) (map (fn [k] (at cfg k)) (except (key cfg) [fee_ppm]))) ins bars tg)))
