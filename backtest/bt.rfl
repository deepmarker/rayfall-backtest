;; Rayfall backtester — accounting kernel.
;;
;; Within a step the phases work on whole per-instrument vectors; the only loops
;; are over time and, when the buys do not all fit, over the cash left for them.
;; ref/bt_ref.rfl is the scalar reference kernel it must match record for
;; record (test/equivalence.rfl).
;;
;; Contracts: doc/contracts.md. Spot, market orders, one
;; venue, one accounting currency, target positions on a fixed bar grid.
;; All money, prices and quantities are fixed-point I64 (cash units, ticks,
;; lots).
;;
;; A run writes no global. bt_simulate owns its state in locals: the records,
;; which it amends in place, and s, the positions and counters. A callee cannot
;; reach those locals and a value passed to it is copy-on-write, so a phase is a
;; pure function: it reads r (the run's inputs, immutable) and s, and returns the
;; next s and the rows to record. Runs are therefore independent values: several
;; can share a process, a strategy can run a nested backtest, and nothing here
;; stands in the way of running them in parallel (test/fixture7.rfl).
;;
;; Entry points; both return the finished run, a dictionary of the configuration
;; (cash0 fee_ppm start period steps max_weight_ppm max_gross_ppm buy_policy),
;; the instruments (syms mult), the final state (cash realized fees seq next_oid
;; qty basis mark mark_ts) and the records (orders order_events fills ledger
;; targets positions equity):
;;   (bt_run cfg instruments bars targets)           targets given as data
;;   (bt_run_strategy cfg instruments bars strategy) targets from a strategy
;;
;;   cfg          {cash0 fee_ppm start period steps max_weight_ppm max_gross_ppm buy_policy};
;;                period is a TIMESPAN, end = start + steps*period; buy_policy REJECT or SCALE
;;   instruments  [sym mult min_qty min_notional ...]
;;   bars         [ts sym o c ...]  ts = bar open, on the grid, < end
;;   targets      [ts sym target]   ts = decision time, on the grid, < end
;;   strategy     a descriptor (bt_strategy name params run prepare):
;;                run      (fn [ctx] table [sym target]), called at every
;;                         decision time; see bt_strategy_targets for ctx,
;;                         which carries params. An absent sym means hold.
;;                prepare  0Nl, or (fn [bars params] table [ts sym f1 ...]):
;;                         features mode, see bt_load_features.
;;                name     a symbol for reports; params a dictionary.

;; ceil(a / b) for a >= 0, b > 0.
(set bt_ceil_div (fn [a b] (div (+ a (- b 1)) b)))

;; ceil(notional * ppm / 1e6), split so no intermediate exceeds notional or 1e6*ppm.
(set bt_fee (fn [ppm notional]
  (+ (* (div notional 1000000) ppm)
     (bt_ceil_div (* (% notional 1000000) ppm) 1000000))))

;; ---------------------------------------------------------------- records

;; Empty record tables: the start of every run, and the rows of a phase that
;; records nothing. Never amended: an insert into a local holding one copies it.
(set bt_empty (dict [orders order_events fills ledger targets positions equity]
                    (list (table [order_id ts sym side qty target pos_before]
                                 (list (as 'I64 []) (as 'TIMESTAMP []) (as 'SYM []) (as 'SYM []) (as 'I64 []) (as 'I64 []) (as 'I64 [])))
                          (table [seq ts order_id event reason]
                                 (list (as 'I64 []) (as 'TIMESTAMP []) (as 'I64 []) (as 'SYM []) (as 'SYM [])))
                          (table [order_id ts sym side qty price notional fee basis_removed realized]
                                 (list (as 'I64 []) (as 'TIMESTAMP []) (as 'SYM []) (as 'SYM []) (as 'I64 []) (as 'I64 [])
                                       (as 'I64 []) (as 'I64 []) (as 'I64 []) (as 'I64 [])))
                          (table [seq ts order_id sym kind cash_delta qty_delta]
                                 (list (as 'I64 []) (as 'TIMESTAMP []) (as 'I64 []) (as 'SYM []) (as 'SYM []) (as 'I64 []) (as 'I64 [])))
                          (table [ts sym requested target limit]
                                 (list (as 'TIMESTAMP []) (as 'SYM []) (as 'I64 []) (as 'I64 []) (as 'SYM [])))
                          (table [ts sym qty basis mark mark_ts mv unrealized]
                                 (list (as 'TIMESTAMP []) (as 'SYM []) (as 'I64 []) (as 'I64 []) (as 'I64 []) (as 'TIMESTAMP [])
                                       (as 'I64 []) (as 'I64 [])))
                          (table [ts cash mv equity realized fees unrealized]
                                 (list (as 'TIMESTAMP []) (as 'I64 []) (as 'I64 []) (as 'I64 []) (as 'I64 []) (as 'I64 []) (as 'I64 []))))))

;; ---------------------------------------------------------------- loading

(set bt_fail (fn [msg] (raise (format "bt: invalid input: %" msg))))

;; Flat grid index k*n + i of each row; raises on off-grid, out-of-range,
;; unknown-symbol or duplicate keys. Rows must satisfy ts < end. g holds the
;; grid: start period steps syms.
(set bt_grid_index (fn [g what ts sym]
  (let off (- ts g.start))
  ;; div keeps the duration tag even for span/span; indices must be I64.
  (let k (as 'I64 (div off g.period)))
  (if (any (!= off (* k g.period))) (bt_fail (format "% off the grid" what)))
  (if (any (or (< k 0) (>= k g.steps))) (bt_fail (format "% outside [start, end)" what)))
  (let i (find g.syms sym))
  (if (any (nil? i)) (bt_fail (format "% has unknown symbols" what)))
  (let flat (+ (* k (count g.syms)) i))
  (if (!= (count (distinct flat)) (count flat)) (bt_fail (format "% has duplicate (ts, sym)" what)))
  flat))

;; Scatter a column onto the K*n grid; missing cells are null.
(set bt_grid (fn [g flat col] (at col (find flat (til (* g.steps (count g.syms)))))))

;; The validated inputs of a run, as a dictionary.
(set bt_load (fn [cfg instruments bars targets]
  (let start (at cfg 'start))
  (let period (at cfg 'period))
  (if (!= (type period) 'timespan) (bt_fail "period must be a positive TIMESPAN"))
  (if (or (nil? period) (<= period 0D)) (bt_fail "period must be a positive TIMESPAN"))
  (let steps (at cfg 'steps))
  (let wppm (at cfg 'max_weight_ppm))
  (let gppm (at cfg 'max_gross_ppm))
  (let policy (at cfg 'buy_policy))
  (if (or (!= (type wppm) 'i64) (!= (type gppm) 'i64) (< wppm 0) (< gppm 0))
      (bt_fail "max_weight_ppm and max_gross_ppm must be non-negative integers"))
  (if (not (in policy [REJECT SCALE])) (bt_fail "buy_policy must be REJECT or SCALE"))
  (let ins (xasc instruments 'sym))
  (let syms (at ins 'sym))
  (let n (count syms))
  (if (!= (count (distinct syms)) n) (bt_fail "duplicate instruments"))
  (let mult (at ins 'mult))
  (let min_qty (at ins 'min_qty))
  (let min_notional (at ins 'min_notional))
  (if (any (<= mult 0)) (bt_fail "mult must be positive"))
  (if (any (nil? (concat min_qty min_notional))) (bt_fail "null instrument limit"))
  (if (any (< (concat min_qty min_notional) 0)) (bt_fail "negative instrument limit"))
  (if (any (nil? (concat (at bars 'o) (at bars 'c)))) (bt_fail "null bar price"))
  (if (any (<= (concat (at bars 'o) (at bars 'c)) 0)) (bt_fail "non-positive bar price"))
  (if (any (nil? (at targets 'target))) (bt_fail "null target"))
  (let g (dict [start period steps syms] (list start period steps syms)))
  (let bflat (bt_grid_index g "bars" (at bars 'ts) (at bars 'sym)))
  (let tflat (bt_grid_index g "targets" (at targets 'ts) (at targets 'sym)))
  (dict [cash0 fee_ppm start period steps max_weight_ppm max_gross_ppm buy_policy
         syms n mult min_qty min_notional open close bars target]
        (list (at cfg 'cash0) (at cfg 'fee_ppm) start period steps wppm gppm policy
              syms n mult min_qty min_notional
              (bt_grid g bflat (at bars 'o))
              (bt_grid g bflat (at bars 'c))
              ;; Strategies see the bars in (ts, sym) order, whatever the input order.
              (xasc bars [ts sym])
              (bt_grid g tflat (at targets 'target))))))

;; ---------------------------------------------------------------- state

(set bt_initial_state (fn [r]
  (dict [cash realized fees seq next_oid qty basis mark mark_ts]
        (list r.cash0 0 0 0 0 (take 0 r.n) (take 0 r.n) (take 0Nl r.n) (take 0Np r.n)))))

;; ---------------------------------------------------------------- phases

;; m ? a : b elementwise, for an I64 mask m of 0/1 and non-null a, b.
(set bt_vsel (fn [m a b] (+ (* m a) (* (- 1 m) b))))

(set bt_phase_mark (fn [r s k T]
  (if (== k 0) s
      (do
        (let c (at r.close (+ (* (- k 1) r.n) (til r.n))))
        (alter 's.mark_ts set (where (not (nil? c))) T)
        (concat s (dict [mark] (list (fill s.mark c))))))))

;; The snapshot rows at T, and the equity they sum to.
(set bt_phase_snapshot (fn [r s T]
  (let mv (fill 0 (* (* s.qty s.mark) r.mult)))
  (let total (sum mv))
  (let equity (+ s.cash total))
  (dict [positions equity value]
        (list (list (take T r.n) r.syms s.qty s.basis s.mark s.mark_ts mv (- mv s.basis))
              (list T s.cash total equity s.realized s.fees (- total (sum s.basis)))
              equity))))

;; Events at T, by order: a SUBMITTED event, then a REJECTED one for each order
;; with a non-empty reason. Sequence numbers follow order_id, as if emitted one
;; order at a time; the run sorts the events by seq at the end.
(set bt_submit_events (fn [seq T oid reason]
  (let m (count oid))
  (let rej (as 'I64 (not (nil? reason))))
  (let cnt (+ 1 rej))
  (let s0 (- (+ seq (sums cnt)) cnt))
  (let x (where (> rej 0)))
  (dict [rows seq]
        (list (list (concat s0 (+ 1 (at s0 x)))
                    (take T (+ m (count x)))
                    (concat oid (at oid x))
                    (concat (take 'SUBMITTED m) (take 'REJECTED (count x)))
                    (concat (take ' m) (at reason x)))
              (+ seq (sum cnt))))))

;; A queue of accepted orders, for the fill phase; x selects them.
(set bt_queue (fn [oid i q x]
  (dict [oid i qty] (list (at oid x) (at i x) (at q x)))))

(set bt_no_queue (dict [oid i qty] (list (as 'I64 []) (as 'I64 []) (as 'I64 []))))

(set bt_no_orders (dict [orders order_events sells buys]
                        (list bt_empty.orders bt_empty.order_events bt_no_queue bt_no_queue)))

(set bt_reject_reasons [' SHORT_NOT_ALLOWED BELOW_MIN_QTY NO_MARK BELOW_MIN_NOTIONAL])

;; Submit the orders that move instruments ix to their applied targets e. Returns
;; the next state, the order and event rows, and the sell and buy queues.
(set bt_submit (fn [r s T ix e]
  (let oi (at ix (where (!= (at e ix) (at s.qty ix)))))
  (let m (count oi))
  (if (== m 0) (concat bt_no_orders (dict [s] (list s)))
      (do
        (let tg (at e oi))
        (let pos (at s.qty oi))
        (let delta (- tg pos))
        (let oid (+ s.next_oid (til m)))
        (let sell (as 'I64 (< delta 0)))
        (let q (abs delta))
        (let mark (at s.mark oi))
        (let code (bt_vsel (as 'I64 (< tg 0)) 1
                           (bt_vsel (as 'I64 (< q (at r.min_qty oi))) 2
                                    (bt_vsel (as 'I64 (nil? mark)) 3
                                             (bt_vsel (as 'I64 (< (fill 0 (* (* q mark) (at r.mult oi)))
                                                                  (at r.min_notional oi)))
                                                      4 0)))))
        (let ev (bt_submit_events s.seq T oid (at bt_reject_reasons code)))
        (let ok (== code 0))
        (dict [s orders order_events sells buys]
              (list (concat s (dict [seq next_oid] (list ev.seq (+ s.next_oid m))))
                    (list oid (take T m) (at r.syms oi) (at [BUY SELL] sell) q tg pos)
                    ev.rows
                    (bt_queue oid oi q (where (and ok (> sell 0))))
                    (bt_queue oid oi q (where (and ok (== sell 0))))))))))

;; The bars whose close is available at T: ts + period <= T.
(set bt_view (fn [r T]
  (let cutoff (- T r.period))
  (select {from: r.bars where: (<= ts cutoff)})))

;; Features mode: (prepare bars params) runs once, on all the bars in (ts, sym)
;; order, and returns a table [ts sym f1 f2 ...] with at most one row per bar
;; key. Each feature is scattered onto the grid; the decision at step k reads,
;; for every instrument, the row of its bar that closed at T (grid step k - 1),
;; null where there is none. A feature row of bar ts must depend only on bars
;; up to ts; the causality tests check it, as for the view.
(set bt_load_features (fn [r]
  (let f (r.prepare r.bars r.params))
  (if (!= (type f) 'TABLE) (raise "bt: prepare must return a table [ts sym ...]"))
  (let flat (bt_grid_index r "features" (at f 'ts) (at f 'sym)))
  (let cells (find flat (til (* r.steps r.n))))
  (let names (except (key f) [ts sym]))
  (dict [feat_names feat_grids] (list names (map (fn [c] (at (at f c) cells)) names)))))

(set bt_feat_row (fn [r k]
  (let ix (if (== k 0) (take (* r.steps r.n) r.n) (+ (* (- k 1) r.n) (til r.n))))
  (dict r.feat_names (map (fn [g] (at g ix)) r.feat_grids))))

;; Targets at T from the strategy, one per instrument (null = hold). The
;; strategy sees only bars whose close is available at T: ts + period <= T.
;; ctx: {k T start period params view equity cash syms qty mark mark_ts mult
;; max_weight_ppm max_gross_ppm}, where params are the strategy's own, and
;; qty, mark, mark_ts and mult are
;; per-instrument vectors in syms order and equity is the pre-trade snapshot
;; at T. In features mode, feat (a dict of feature vectors in syms order)
;; replaces view.
(set bt_strategy_targets (fn [r s k T equity]
  (let ctx (if r.use_features
               (dict [k T start period params feat equity cash syms qty mark mark_ts mult
                      max_weight_ppm max_gross_ppm]
                     (list k T r.start r.period r.params (bt_feat_row r k) equity s.cash
                           r.syms s.qty s.mark s.mark_ts r.mult r.max_weight_ppm r.max_gross_ppm))
               (dict [k T start period params view equity cash syms qty mark mark_ts mult
                      max_weight_ppm max_gross_ppm]
                     (list k T r.start r.period r.params (bt_view r T) equity s.cash
                           r.syms s.qty s.mark s.mark_ts r.mult r.max_weight_ppm r.max_gross_ppm))))
  (let res (r.run ctx))
  (if (!= (type res) 'TABLE) (raise "bt: strategy must return a table [sym target]"))
  (let rs (at res 'sym))
  (let rt (at res 'target))
  (if (!= (type rt) 'I64) (raise "bt: strategy target column must be I64 lots"))
  (if (any (nil? rt)) (raise "bt: strategy returned a null target"))
  (if (any (nil? (find r.syms rs))) (raise "bt: strategy returned an unknown symbol"))
  (if (!= (count (distinct rs)) (count rs)) (raise "bt: strategy returned a symbol twice"))
  (at rt (find rs r.syms))))

;; ---------------------------------------------------------------- limits

;; floor(x * ppm / 1e6) for x >= 0, split so no intermediate exceeds x or 1e6*ppm.
(set bt_ppm_of (fn [x ppm]
  (+ (* (div x 1000000) ppm) (div (* (% x 1000000) ppm) 1000000))))

;; Values of the targets e (lots per instrument) at the marks, in cash units. A
;; target with no mark, or not above zero, counts as 0: submission rejects it
;; or it is flat.
(set bt_values (fn [r s e] (* (fill 0 (* (* e s.mark) r.mult)) (as 'I64 (> e 0)))))

;; floor(e * f) in lots.
(set bt_scale (fn [e f] (as 'I64 (floor (* (as 'F64 e) f)))))

;; Apply the position limits to the requested targets req (lots per instrument,
;; null = hold). Returns the result e and, in why, the limit that last changed
;; each target. Values are taken at the decision-time mark against
;; pre-trade equity. Each requested target is capped at max_weight of equity.
;; Then, if the requested targets together exceed the room that max_gross of
;; equity leaves beside the held positions, they are scaled by one factor,
;; rounding down to lots. The factor is a float; the exact integer total is
;; checked and the factor shrunk until it fits. Limits never touch a held
;; position: one that drifts past a limit is left until the next request.
(set bt_constrain (fn [r s req equity]
  (let asked (as 'I64 (not (nil? req))))
  (let e (fill 0 req))
  (let wcap (bt_ppm_of equity r.max_weight_ppm))
  (let over (* asked (as 'I64 (> (bt_values r s e) wcap))))
  (let e (bt_vsel over (fill 0 (div wcap (* s.mark r.mult))) e))
  (let why (take ' r.n))
  (alter 'why set (where (> over 0)) 'MAX_WEIGHT)
  (let held_value (sum (* (- 1 asked) (bt_values r s s.qty))))
  (let room (- (bt_ppm_of equity r.max_gross_ppm) held_value))
  (let room (if (< room 0) 0 room))
  (let total (sum (* asked (bt_values r s e))))
  (if (> total room)
      (do
        (let e0 e)
        (let m (* asked (as 'I64 (> (bt_values r s e0) 0))))
        (let f (/ (as 'F64 room) (as 'F64 total)))
        (let e (bt_vsel m (bt_scale e0 f) e0))
        (alter 'why set (where (and (> m 0) (< e e0))) 'MAX_GROSS)
        (while (> (sum (* asked (bt_values r s e))) room)
          (let f (* f 0.999999999))
          (let e (bt_vsel m (bt_scale e0 f) e0))
          (alter 'why set (where (and (> m 0) (< e e0))) 'MAX_GROSS))))
  (dict [e why] (list e why))))

;; ---------------------------------------------------------------- decide

;; Requested targets at T (null = hold), from the strategy or the target rows,
;; go through the position limits; each one gets a targets row and, if it
;; differs from the position, an order. Returns what bt_submit returns, and the
;; targets rows.
(set bt_phase_decide (fn [r s k T equity]
  (let req (if r.use_strategy (bt_strategy_targets r s k T equity)
               (at r.target (+ (* k r.n) (til r.n)))))
  (let lim (bt_constrain r s req equity))
  (let ix (where (not (nil? req))))
  (if (== (count ix) 0) (concat bt_no_orders (dict [s targets] (list s bt_empty.targets)))
      (concat (bt_submit r s T ix lim.e)
              (dict [targets]
                    (list (list (take T (count ix)) (at r.syms ix) (at req ix) (at lim.e ix) (at lim.why ix))))))))

;; ---------------------------------------------------------------- fills
;; Every order takes the sequence numbers it would one at a time: one if it is
;; rejected; three if it fills (TRADE and FEE ledger rows, FILLED event).

;; The fill and ledger rows of filled orders, given per fill. A SELL brings cash
;; in and a BUY pays it out.
(set bt_fill_rows (fn [r T side oid i s0 q px notional fee removed realized]
  (let m (count oid))
  (let tm (take T m))
  (let syms (at r.syms i))
  (let sign (if (== side 'SELL) 1 -1))
  (dict [fills ledger]
        (list (list oid tm syms (take side m) q px notional fee removed realized)
              (list (concat s0 (+ s0 1))
                    (concat tm tm)
                    (concat oid oid)
                    (concat syms syms)
                    (concat (take 'TRADE m) (take 'FEE m))
                    (concat (* sign notional) (neg fee))
                    (concat (* (neg sign) q) (take 0 m)))))))

;; Event rows of orders at T: reason for the rejected ones (ok false), FILLED
;; with reason why for the others.
(set bt_fill_events (fn [T oid s0 ok reason why]
  (let x (where (not ok)))
  (let f (where ok))
  (list (concat (at s0 x) (+ 2 (at s0 f)))
        (take T (count oid))
        (concat (at oid x) (at oid f))
        (concat (take 'REJECTED (count x)) (take 'FILLED (count f)))
        (concat (at reason x) (at why f)))))

;; Sells at T, all at once: none depends on cash.
(set bt_fill_sells (fn [r s k T o]
  (let i o.i)
  (let q o.qty)
  (let px (at r.open (+ (* k r.n) i)))
  (let held (at s.qty i))
  (let nopx (nil? px))
  (let ok (and (not nopx) (<= q held)))
  (let cnt (+ 1 (* 2 (as 'I64 ok))))
  (let s0 (- (+ s.seq (sums cnt)) cnt))
  (let f (where ok))
  (let fi (at i f))
  (let fq (at q f))
  (let fpx (at px f))
  (let fh (at held f))
  (let basis (at s.basis fi))
  (let notional (* (* fq fpx) (at r.mult fi)))
  (let fee (bt_fee r.fee_ppm notional))
  ;; floor(basis * q / held); a full close removes all basis.
  (let removed (bt_vsel (as 'I64 (== fq fh)) basis
                        (+ (* (div basis fh) fq) (div (* (% basis fh) fq) fh))))
  (let realized (- notional removed))
  (alter 's.qty set fi (- fh fq))
  (alter 's.basis set fi (- basis removed))
  (let rows (bt_fill_rows r T 'SELL (at o.oid f) fi (at s0 f) fq fpx notional fee removed realized))
  (dict [s fills ledger order_events]
        (list (concat s (dict [cash realized fees seq]
                              (list (- (+ s.cash (sum notional)) (sum fee))
                                    (+ s.realized (sum realized))
                                    (+ s.fees (sum fee))
                                    (+ s.seq (sum cnt)))))
              rows.fills
              rows.ledger
              (bt_fill_events T o.oid s0 ok
                              (at [INSUFFICIENT_POSITION NO_PRICE] (as 'I64 nopx))
                              (take ' (count o.oid)))))))

;; The quantities and rejection reasons of the buys under each policy. Under
;; SCALE, if the buys priced at the open cost more, fees included, than the cash
;; left after the sells, each one is cut to the same fraction f of its quantity,
;; rounding down to lots, and is FILLED with reason SCALED; the rest of the order
;; lapses. f keeps back one cash unit per buy for fee rounding, so the cut buys
;; fit; bt_ration still guards. Limits are checked on the cut quantity at the
;; fill price.
(set bt_buy_plan (fn [r s o px]
  (let i o.i)
  (let q o.qty)
  (let nopx (as 'I64 (nil? px)))
  (if (== r.buy_policy 'REJECT)
      (dict [q2 reason] (list q (at [' NO_PRICE] nopx)))
      (do
        (let notional (fill 0 (* (* q px) (at r.mult i))))
        (let total (sum (* (- 1 nopx) (+ notional (bt_fee r.fee_ppm notional)))))
        (let room (- s.cash (- (count q) (sum nopx))))
        (let f (if (<= total s.cash) 1.0
                   (<= room 0) 0.0
                   (/ (as 'F64 room) (as 'F64 total))))
        (let q2 (if (== f 1.0) q (bt_scale q f)))
        (let code (bt_vsel nopx 1
                           (bt_vsel (as 'I64 (== q2 0)) 2
                                    (bt_vsel (as 'I64 (< q2 (at r.min_qty i))) 3
                                             (bt_vsel (as 'I64 (< (fill 0 (* (* q2 px) (at r.mult i)))
                                                                  (at r.min_notional i)))
                                                      4 0)))))
        (dict [q2 reason]
              (list q2 (at [' NO_PRICE INSUFFICIENT_CASH BELOW_MIN_QTY BELOW_MIN_NOTIONAL] code)))))))

;; Spend cash in order_id order: a buy that costs more than what is left is
;; rejected. A buy already rejected costs 0, so it never comes here with a reason
;; to lose: cash is not negative.
(set bt_ration (fn [reason cost cash]
  (times [j (count cost)]
    (if (> (at cost j) cash) (alter 'reason set j 'INSUFFICIENT_CASH)
        (let cash (- cash (at cost j)))))
  reason))

;; Buys at T. They depend on cash only when they do not all fit.
(set bt_fill_buys (fn [r s k T o]
  (let i o.i)
  (let q0 o.qty)
  (let open_px (at r.open (+ (* k r.n) i)))
  (let plan (bt_buy_plan r s o open_px))
  (let px (fill 0 open_px))
  (let lot_value (* px (at r.mult i)))
  (let asked (* (* plan.q2 lot_value) (as 'I64 (nil? plan.reason))))
  (let cost (+ asked (bt_fee r.fee_ppm asked)))
  (let reason (if (any (> (sums cost) s.cash)) (bt_ration plan.reason cost s.cash) plan.reason))
  (let ok (nil? reason))
  (let cnt (+ 1 (* 2 (as 'I64 ok))))
  (let s0 (- (+ s.seq (sums cnt)) cnt))
  (let f (where ok))
  (let fi (at i f))
  (let fq (at plan.q2 f))
  (let notional (* fq (at lot_value f)))
  (let fee (bt_fee r.fee_ppm notional))
  (let m (count f))
  (alter 's.qty set fi (+ (at s.qty fi) fq))
  (alter 's.basis set fi (+ (at s.basis fi) notional))
  (let rows (bt_fill_rows r T 'BUY (at o.oid f) fi (at s0 f) fq (at px f) notional fee (take 0 m) (take 0 m)))
  (let scaled (as 'I64 (< plan.q2 q0)))
  (dict [s fills ledger order_events]
        (list (concat s (dict [cash fees seq]
                              (list (- s.cash (sum (+ notional fee)))
                                    (+ s.fees (sum fee))
                                    (+ s.seq (sum cnt)))))
              rows.fills
              rows.ledger
              (bt_fill_events T o.oid s0 ok reason (at [' SCALED] scaled))))))

;; Execute the queues at the open of bar [T, T+period): sells first, so that
;; buys can spend their proceeds.
(set bt_phase_fill (fn [r s k T sells buys]
  (let fills bt_empty.fills)
  (let ledger bt_empty.ledger)
  (let events bt_empty.order_events)
  (if (> (count sells.oid) 0)
      (do
        (let f (bt_fill_sells r s k T sells))
        (let s f.s)
        (insert 'fills f.fills)
        (insert 'ledger f.ledger)
        (insert 'events f.order_events)))
  (if (> (count buys.oid) 0)
      (do
        (let f (bt_fill_buys r s k T buys))
        (let s f.s)
        (insert 'fills f.fills)
        (insert 'ledger f.ledger)
        (insert 'events f.order_events)))
  (dict [s fills ledger order_events] (list s fills ledger events))))

;; ---------------------------------------------------------------- run

(set bt_no_targets (table [ts sym target] (list (as 'TIMESTAMP []) (as 'SYM []) (as 'I64 []))))

;; A strategy descriptor. params is a dictionary; prepare is 0Nl unless the
;; strategy runs in features mode.
(set bt_strategy (fn [name params run prepare]
  (dict [name params run prepare] (list name params run prepare))))

(set bt_check_strategy (fn [d]
  (if (or (!= (type d) 'DICT) (not (all (in [name params run prepare] (key d)))))
      (raise "bt: strategy must be a descriptor {name params run prepare} (bt_strategy)"))
  (if (!= (type (at d 'params)) 'DICT) (raise "bt: strategy params must be a dictionary"))))

;; The run's inputs that come from the strategy, which may be 0Nl.
(set bt_load_strategy (fn [strategy]
  (if (nil? strategy) (dict [use_strategy use_features] (list false false))
      (do
        (bt_check_strategy strategy)
        (dict [use_strategy use_features run params prepare]
              (list true (not (nil? (at strategy 'prepare)))
                    (at strategy 'run) (at strategy 'params) (at strategy 'prepare)))))))

;; Entry points. strategy is a descriptor, or 0Nl for targets given as data.
(set bt_run_strategy (fn [cfg instruments bars strategy]
  (bt_simulate cfg instruments bars bt_no_targets strategy)))

(set bt_run (fn [cfg instruments bars targets]
  (bt_simulate cfg instruments bars targets 0Nl)))

;; The event loop, and the only place records grow: rec is this call's own, so
;; it is amended in place and a run costs what its rows cost.
(set bt_simulate (fn [cfg instruments bars targets strategy]
  (let from_strategy (bt_load_strategy strategy))
  (let r (concat (bt_load cfg instruments bars targets) from_strategy))
  (let r (if r.use_features (concat r (bt_load_features r)) r))
  (let s (bt_initial_state r))
  (let rec bt_empty)
  (times [k (+ r.steps 1)]
    (let T (+ r.start (* k r.period)))
    (let s (bt_phase_mark r s k T))
    (let snap (bt_phase_snapshot r s T))
    (insert 'rec.positions snap.positions)
    (insert 'rec.equity snap.equity)
    (if (< k r.steps)
        (do
          (let d (bt_phase_decide r s k T snap.value))
          (let f (bt_phase_fill r d.s k T d.sells d.buys))
          (let s f.s)
          (insert 'rec.targets d.targets)
          (insert 'rec.orders d.orders)
          (insert 'rec.order_events d.order_events)
          (insert 'rec.fills f.fills)
          (insert 'rec.ledger f.ledger)
          (insert 'rec.order_events f.order_events))))
  ;; within a step, events and ledger rows are written by kind; put them in
  ;; the order of their sequence numbers
  (let kept [cash0 fee_ppm start period steps max_weight_ppm max_gross_ppm buy_policy syms mult])
  (concat (concat (dict kept (map (fn [c] (at r c)) kept)) s)
          (concat rec (dict [order_events ledger]
                            (list (xasc rec.order_events 'seq) (xasc rec.ledger 'seq)))))))
