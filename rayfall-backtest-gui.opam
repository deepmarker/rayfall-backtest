# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Native desktop workbench for Rayfall backtests"
maintainer: ["Vincent Bernardoff"]
authors: ["Vincent Bernardoff"]
license: "ISC"
homepage: "https://github.com/deepmarker/rayfall-backtest"
bug-reports: "https://github.com/deepmarker/rayfall-backtest/issues"
depends: [
  "dune" {>= "3.21"}
  "rayfall-backtest"
  "imguiml-ft"
  "ctypes"
  "ctypes-foreign"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/deepmarker/rayfall-backtest.git"
x-maintenance-intent: ["(latest)"]
